{
  "name": "vinyl-periphery",
  "version": "0.1.0",
  "description": "Unravel the web of influence behind your favourite albums",
  "main": "backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm run dev",
    "install-client": "cd frontend && npm install",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm run install-client && cd frontend && npm run build",
    "test": "node --test \"backend/**/*.test.js\" docs/analytics/apps-script.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
